{
  "name": "relay-claude",
  "version": "0.5.0",
  "description": "Stagger multiple Claude Code accounts to extend your daily quota beyond the 5-hour limit",
  "type": "module",
  "bin": {
    "relay-claude": "./bin/interval-claude",
    "interval-claude": "./bin/interval-claude"
  },
  "main": "./src/cli.js",
  "scripts": {
    "test": "node --test tests/config.test.js tests/pinger.test.js tests/scheduler.test.js tests/state.test.js tests/keychain.test.js tests/oauth.test.js tests/notifier.test.js tests/use.test.js tests/daemon.test.js",
    "test:all": "node --test tests/*.test.js",
    "changelog": "conventional-changelog -p angular -i CHANGELOG.md -s -r 0",
    "prepublishOnly": "npm test",
    "start": "node bin/interval-claude"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "bin/",
    "src/",
    "README.md",
    "README.zh-CN.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "keywords": [
    "claude",
    "claude-code",
    "anthropic",
    "rate-limit",
    "quota",
    "rotation",
    "multi-account",
    "cli",
    "daemon",
    "tui"
  ],
  "license": "MIT",
  "author": "yezannnnn",
  "repository": {
    "type": "git",
    "url": "https://github.com/yezannnnn/relay-claude.git"
  },
  "homepage": "https://github.com/yezannnnn/relay-claude#readme",
  "bugs": {
    "url": "https://github.com/yezannnnn/relay-claude/issues"
  },
  "devDependencies": {
    "conventional-changelog-cli": "^5.0.0"
  }
}
